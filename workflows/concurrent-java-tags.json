{
  "kind": "workflow_definition",
  "agent": "agents/implementer.md",
  "skills": [
    "skills/code-implementation/SKILL.md",
    "skills/workspace-isolation/SKILL.md"
  ],
  "timeout": 30,
  "command": [
    "{java}",
    "-XX:-UsePerfData",
    "{java-tmp-option}",
    "FeatureWriter.java",
    "tags"
  ],
  "allowed_write": [
    "TagPolicy.java"
  ],
  "success_pattern": "^FEATURE_TAGS_OK$"
}
